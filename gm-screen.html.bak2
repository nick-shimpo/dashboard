let enemyCounter = 0;

function addEnemy(type) {
  const stats = ENEMY_STATS[type];
  const id = `enemy-${++enemyCounter}`;
  const tracker = document.getElementById('encounter-tracker');

  const enemyCard = document.createElement('div');
  enemyCard.id = id;
  enemyCard.className = 'enemy-card';
  enemyCard.innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
      <strong style="color:var(--red)">${stats.name} #${enemyCounter}</strong>
      <button onclick="removeEnemy('${id}')" style="background:var(--red);color:white;border:none;padding:2px 8px;cursor:pointer;font-family:inherit;font-size:11px;border-radius:2px">✕</button>
    </div>
    <div class="enemy-stats">
      <div><strong>HP:</strong> <input type="number" value="${stats.hp}" style="width:50px;font-family:inherit;padding:2px 4px"> / ${stats.hp}</div>
      <div><strong>Armor:</strong> ${stats.armor}</div>
      <div><strong>Instinct:</strong> ${stats.instinct}% | <strong>Combat:</strong> ${stats.combat}%</div>
      <div><strong>Attacks:</strong> ${stats.attacks}</div>
      <div style="margin-top:4px;color:var(--dim);font-size:13px">${stats.notes}</div>
    </div>
  `;

  tracker.appendChild(enemyCard);
}

function removeEnemy(id) {
  document.getElementById(id).remove();
}
