<!-- ==================== ENCOUNTER BUILDER ==================== -->
<div class="encounter-section">
  <div class="panel-header ph-red" style="margin-bottom:16px">
    ⚔ Encounter Builder
  </div>

  <!-- COMBAT RULES QUICK REFERENCE -->
  <div class="combat-rules">
    <div class="rule-column">
      <div class="rule-title">Initiative</div>
      <div class="rule-text">Combat Check. Highest goes first. Ties = simultaneous.</div>

      <div class="rule-title">Attacking</div>
      <div class="rule-text">Roll d100 ≤ Combat skill. Hit = roll damage.</div>

      <div class="rule-title">Damage</div>
      <div class="rule-text">Roll weapon damage. Target reduces by Armor, then subtracts from HP.</div>
    </div>

    <div class="rule-column">
      <div class="rule-title">Critical Hit (01-10)</div>
      <div class="rule-text">Max damage + roll again.</div>

      <div class="rule-title">Fumble (96-00)</div>
      <div class="rule-text">Miss + GM complication (jam, drop, hurt self).</div>

      <div class="rule-title">Panic Check</div>
      <div class="rule-text">Fear Save when threatened. Fail = roll Panic table, lose action.</div>
    </div>
  </div>

  <hr style="border:none;border-top:1px solid var(--border);margin:20px 0">

  <!-- ENEMY QUICK-ADD -->
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:20px">
    <button class="enemy-add-btn" onclick="addEnemy('carcinid-basic')">+ Basic Carcinid</button>
    <button class="enemy-add-btn" onclick="addEnemy('carcinid-advanced')">+ Advanced Carcinid</button>
    <button class="enemy-add-btn" onclick="addEnemy('mimic')">+ The Mimic</button>
    <button class="enemy-add-btn" onclick="addEnemy('shaw')">+ Shaw</button>
  </div>

  <!-- ACTIVE ENEMIES TRACKER -->
  <div id="encounter-tracker" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(350px,1fr));gap:16px">
    <!-- Enemy cards appear here -->
  </div>
</div>

<!-- ===== JAVASCRIPT ===== -->
<script>
function togglePanel(header) {
  header.parentElement.classList.toggle('collapsed');
}

function updateClock() {
  const now = new Date();
  document.getElementById('clock').textContent =
    now.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
}
updateClock();
setInterval(updateClock, 30000);

// ===== PERIL OMEN LOGIC =====
function updateOmens(clickedLabel) {
  // Let the checkbox toggle first
  setTimeout(() => {
    const peril = clickedLabel.closest('[data-peril]');
    const omens = peril.querySelectorAll('.omen');
    let foundNextUp = false;

    omens.forEach(omen => {
      const cb = omen.querySelector('input[type="checkbox"]');
      omen.classList.remove('checked', 'next-up');

      if (cb.checked) {
        omen.classList.add('checked');
      } else if (!foundNextUp) {
        omen.classList.add('next-up');
        foundNextUp = true;
      }
    });
  }, 10);
}

// ===== PARTY COMPOSITION TRACKER =====
const PARTY_STORAGE_KEY = 'gm-party-tracker-v1';

const PARTY_DEFAULT = {
  groups: [
    {
      id: 'g-alpha',
      name: 'Team Alpha',
      offscreen: false,
      people: [
        { id: 'p-bud',    name: 'Bud',    role: 'Teamster · legless',         voice: 'shock, gritted teeth, "carry me"', kind: 'pc',        status: 'Stabilised, immobile', knows: '' },
        { id: 'p-rick',   name: 'Rick',   role: 'Marine · sister killed',     voice: 'flat, traumatized, short answers', kind: 'pc',        status: 'Numb', knows: '' },
        { id: 'p-tandy',  name: 'Tandy',  role: 'Scientist',                  voice: 'analytical, asks why',             kind: 'pc',        status: 'Knows mother absorbing radiation', knows: 'mother absorbing radiation' },
        { id: 'p-valdez', name: 'Valdez', role: 'Marine sergeant',            voice: 'calm authority, "stay tight"',     kind: 'npc-ally',  status: 'Leading the climb', knows: 'reactor med unit protocol' }
      ]
    },
    {
      id: 'g-willis',
      name: 'Willis',
      offscreen: false,
      people: [
        { id: 'p-willis', name: 'Willis', role: 'Teamster · McClane',         voice: 'wisecracks under pressure, sweary', kind: 'pc',        status: 'Hangar, shaken (saw Shaw kill Edem)', knows: 'Shaw is hostile' }
      ]
    },
    {
      id: 'g-offscreen',
      name: 'Off-screen',
      offscreen: true,
      people: [
        { id: 'p-brookman', name: 'Brookman', role: 'Medic · fled',           voice: 'panicked, justifying',             kind: 'npc-neutral', status: 'On stolen ATV, gone', knows: '' },
        { id: 'p-shaw',     name: 'Shaw',     role: 'Android · antagonist',   voice: 'flat, polite, terminal',           kind: 'npc-hostile', status: 'At large, presumed lab',  knows: 'wants Hinton logic core' },
        { id: 'p-pilots',   name: 'Pilots',   role: 'Dropship · 2 crew',      voice: 'impatient, "we are leaving"',      kind: 'npc-neutral', status: 'Planetside, wants to leave', knows: '' }
      ]
    }
  ]
};

function loadParty() {
  try {
    const raw = localStorage.getItem(PARTY_STORAGE_KEY);
    if (!raw) return structuredClone(PARTY_DEFAULT);
    return JSON.parse(raw);
  } catch (e) {
    return structuredClone(PARTY_DEFAULT);
  }
}

function saveParty(state) {
  localStorage.setItem(PARTY_STORAGE_KEY, JSON.stringify(state));
}

let partyState = loadParty();

function renderParty() {
  const root = document.getElementById('party-groups');
  if (!root) return;
  root.innerHTML = '';

  partyState.groups.forEach(group => {
    const col = document.createElement('div');
    col.className = 'party-group' + (group.offscreen ? ' offscreen' : '');
    col.dataset.groupId = group.id;

    col.addEventListener('dragover', e => { e.preventDefault(); col.classList.add('dragover'); });
    col.addEventListener('dragleave', () => col.classList.remove('dragover'));
    col.addEventListener('drop', e => {
      e.preventDefault();
      col.classList.remove('dragover');
      const personId = e.dataTransfer.getData('text/person-id');
      if (personId) movePerson(personId, group.id);
    });

    const nameEl = document.createElement('div');
    nameEl.className = 'party-group-name';
    nameEl.textContent = group.name;
    nameEl.title = 'Click to rename · double-click to remove group';
    nameEl.addEventListener('click', () => renameGroup(group.id));
    nameEl.addEventListener('dblclick', () => removeGroup(group.id));
    col.appendChild(nameEl);

    const list = document.createElement('div');
    list.className = 'party-members';

    group.people.forEach(person => list.appendChild(buildPersonCard(person, group.id)));

    const addBtn = document.createElement('button');
    addBtn.className = 'person-add';
    addBtn.textContent = '+ person';
    addBtn.addEventListener('click', () => addPerson(group.id));
    list.appendChild(addBtn);

    col.appendChild(list);
    root.appendChild(col);
  });
}

function buildPersonCard(person, groupId) {
  const card = document.createElement('div');
  card.className = 'person ' + (person.kind || 'pc');
  card.draggable = true;
  card.dataset.personId = person.id;

  card.addEventListener('dragstart', e => {
    e.dataTransfer.setData('text/person-id', person.id);
    card.classList.add('dragging');
  });
  card.addEventListener('dragend', () => card.classList.remove('dragging'));

  const line = document.createElement('div');
  line.className = 'person-line';
  line.innerHTML =
    `<span class="person-name">${escapeHtml(person.name)}</span>` +
    `<span class="person-role"> · ${escapeHtml(person.role || '')}</span>`;
  if (person.voice) {
    line.innerHTML += `<div class="person-voice">${escapeHtml(person.voice)}</div>`;
  }
  card.appendChild(line);

  if (person.status || person.knows) {
    const detail = document.createElement('div');
    detail.className = 'person-detail';
    if (person.status) detail.innerHTML += `<div><b>status:</b> ${escapeHtml(person.status)}</div>`;
    if (person.knows)  detail.innerHTML += `<div><b>knows:</b> ${escapeHtml(person.knows)}</div>`;
    card.appendChild(detail);
  }

  card.addEventListener('click', e => {
    if (e.target.closest('button')) return;
    card.classList.toggle('expanded');
  });

  card.addEventListener('contextmenu', e => {
    e.preventDefault();
    editPerson(person.id);
  });

  return card;
}

function escapeHtml(s) {
  return String(s ?? '').replace(/[&<>"']/g, c => ({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
  }[c]));
}

function findPerson(personId) {
  for (const g of partyState.groups) {
    const p = g.people.find(p => p.id === personId);
    if (p) return { group: g, person: p };
  }
  return null;
}

function movePerson(personId, targetGroupId) {
  const found = findPerson(personId);
  if (!found) return;
  if (found.group.id === targetGroupId) return;
  found.group.people = found.group.people.filter(p => p.id !== personId);
  const target = partyState.groups.find(g => g.id === targetGroupId);
  if (target) target.people.push(found.person);
  saveParty(partyState);
  renderParty();
}

function addPartyGroup() {
  const name = prompt('Group name?');
  if (!name) return;
  partyState.groups.push({
    id: 'g-' + Date.now(),
    name: name.trim(),
    offscreen: /off.?screen|elsewhere|missing/i.test(name),
    people: []
  });
  saveParty(partyState);
  renderParty();
}

function renameGroup(groupId) {
  const g = partyState.groups.find(g => g.id === groupId);
  if (!g) return;
  const name = prompt('Rename group:', g.name);
  if (!name) return;
  g.name = name.trim();
  g.offscreen = /off.?screen|elsewhere|missing/i.test(g.name);
  saveParty(partyState);
  renderParty();
}

function removeGroup(groupId) {
  const g = partyState.groups.find(g => g.id === groupId);
  if (!g) return;
  if (g.people.length > 0) {
    if (!confirm(`Remove "${g.name}" and its ${g.people.length} people?`)) return;
  } else {
    if (!confirm(`Remove "${g.name}"?`)) return;
  }
  partyState.groups = partyState.groups.filter(x => x.id !== groupId);
  saveParty(partyState);
  renderParty();
}

function addPerson(groupId) {
  const name = prompt('Name?');
  if (!name) return;
  const role  = prompt('Role / tag (e.g. "Marine · sergeant"):', '') || '';
  const voice = prompt('Voice cue (one short line):', '') || '';
  const kind  = prompt('Kind: pc | npc-ally | npc-neutral | npc-hostile', 'npc-neutral') || 'npc-neutral';
  const g = partyState.groups.find(g => g.id === groupId);
  if (!g) return;
  g.people.push({
    id: 'p-' + Date.now(),
    name: name.trim(),
    role: role.trim(),
    voice: voice.trim(),
    kind: kind.trim(),
    status: '',
    knows: ''
  });
  saveParty(partyState);
  renderParty();
}

function editPerson(personId) {
  const found = findPerson(personId);
  if (!found) return;
  const p = found.person;
  const action = prompt(
    `Edit ${p.name}:\n` +
    `1 = name\n2 = role\n3 = voice\n4 = status\n5 = knows\n6 = kind\n9 = DELETE\n\nEnter number:`
  );
  if (!action) return;
  switch (action.trim()) {
    case '1': { const v = prompt('Name:', p.name);  if (v !== null) p.name = v.trim(); break; }
    case '2': { const v = prompt('Role:', p.role);  if (v !== null) p.role = v.trim(); break; }
    case '3': { const v = prompt('Voice cue:', p.voice); if (v !== null) p.voice = v.trim(); break; }
    case '4': { const v = prompt('Status:', p.status); if (v !== null) p.status = v.trim(); break; }
    case '5': { const v = prompt('Knows:', p.knows);   if (v !== null) p.knows = v.trim(); break; }
    case '6': { const v = prompt('Kind (pc | npc-ally | npc-neutral | npc-hostile):', p.kind); if (v !== null) p.kind = v.trim(); break; }
    case '9': {
      if (confirm(`Delete ${p.name}?`)) {
        found.group.people = found.group.people.filter(x => x.id !== p.id);
      }
      break;
    }
  }
  saveParty(partyState);
  renderParty();
}

function resetPartyTracker() {
  if (!confirm('Reset Party Tracker to default seed? This wipes any edits.')) return;
  partyState = structuredClone(PARTY_DEFAULT);
  saveParty(partyState);
  renderParty();
}

renderParty();
// ===== COMPLICATION TABLE =====
const COMPLICATIONS = {
  2:  'Full blackout — everything dies, battery torches only',
  3:  'Structural groan — somewhere close, something is giving way',
  4:  'Water surge — ankle-deep becomes knee-deep in seconds',
  5:  'Radio burst — fragment of voice, could be anyone',
  6:  'Torch flicker — light source dims, recovers, dims again',
  7:  'Rhythmic sound — click-click-click from behind the walls',
  8:  'Peripheral movement — something at the edge of your light',
  9:  'Temperature change — sudden warmth, sweet smell, wrong',
  10: 'Wet footprints — not yours, fresh, leading away from you',
  11: 'Equipment malfunction — comm static, suit alarm, jammed door',
  12: 'Direct contact — something touches you in the dark'
};

function rollComplication() {
  const d1 = Math.floor(Math.random() * 6) + 1;
  const d2 = Math.floor(Math.random() * 6) + 1;
  const total = d1 + d2;
  const box = document.getElementById('complication-result');
  const color = total <= 3 ? 'var(--red)' : total <= 5 ? 'var(--amber)' : total >= 11 ? 'var(--red)' : 'var(--text)';
  box.innerHTML = `
    <div class="complication-result">
      <span class="complication-roll" style="color:${color}">${total}</span>
      <span style="color:var(--dim)">(${d1}+${d2})</span>
      <div style="margin-top:4px">${COMPLICATIONS[total]}</div>
    </div>
  `;
  flash(box);
}

// ===== ORACLE =====
