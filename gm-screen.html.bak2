// ===== UTILITY =====
function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }
function pickN(arr, n) { return [...arr].sort(() => Math.random() - 0.5).slice(0, n); }
function flash(el) { el.classList.add('flash'); setTimeout(() => el.classList.remove('flash'), 400); }

function rollOracle() {
  const box = document.getElementById('oracle-result');
  box.innerHTML = `<span class="action-word">${pick(ACTIONS)}</span><span class="plus">+</span><span class="theme-word">${pick(THEMES)}</span>`;
  flash(box);
}

function rollDescriptors(category, count) {
  const words = pickN(DESCRIPTORS[category], count);
  const container = document.getElementById(category + '-chips');
  container.innerHTML = words.map(w => `<span class="chip fresh">${w}</span>`).join('');
  setTimeout(() => container.querySelectorAll('.chip').forEach(c => c.classList.remove('fresh')), 500);
}

function rollName() {
  const box = document.getElementById('name-result');
  box.innerHTML = `<span class="name-result">${pick(FIRST_NAMES)}</span>`;
  flash(box);
}

function rollSceneSeed() {
  const box = document.getElementById('seed-result');
  box.innerHTML = `
    <div style="font-size:14px"><span class="bright">${pick(SCENE_ACTIONS)} ${pick(SCENE_LOCATIONS)}.</span></div>
    <div style="font-size:12px;color:var(--dim)">Mood: <span style="color:var(--red);font-weight:bold">${pick(DESCRIPTORS.emotional)}</span></div>
  `;
  flash(box);
}

function rollAll() {
  rollComplication();
  rollOracle();
  rollDescriptors('carcinid', 4);
  rollDescriptors('station', 3);
  rollDescriptors('bodyhorror', 3);
  rollDescriptors('sound', 3);
  rollDescriptors('emotional', 2);
  rollName();
  rollSceneSeed();
}

// ===== SCENE DRESSING =====
const DRESSING = [
  // OBJECTS — things you find
  {cat:'Object', text:'Laminated evacuation map, water-stained, route marked in red pen'},
  {cat:'Object', text:'Empty coffee mug with a name scratched into the handle'},
  {cat:'Object', text:'Personal locker, door hanging open, photos taped inside'},
  {cat:'Object', text:'Fire extinguisher pulled from bracket, lying on the floor'},
  {cat:'Object', text:'Clipboard with maintenance checklist, last entry half-finished'},
  {cat:'Object', text:'Boot print in something dark and sticky, heading toward a door'},
  {cat:'Object', text:'Hard hat with company logo, cracked down the middle'},
  {cat:'Object', text:'Roll of duct tape wrapped around a pipe joint — makeshift repair'},
  {cat:'Object', text:'Duffel bag, zipped shut, heavier than it looks'},
  {cat:'Object', text:'Wedding ring sitting on top of a folded uniform'},
  {cat:'Object', text:'Flashlight, still on, beam pointing at the ceiling'},
  {cat:'Object', text:'Child\'s drawing pinned to a notice board — crayon sun, stick figures'},
  {cat:'Object', text:'Toolbox, open, wrenches scattered as if dropped in a hurry'},
  {cat:'Object', text:'Handwritten note: "DON\'T GO BELOW LEVEL 3"'},
  {cat:'Object', text:'Radio handset hanging by its cord, faint static'},

  // TEXTURES — surface details
  {cat:'Texture', text:'Condensation beading on cold pipes, running in slow trails'},
  {cat:'Texture', text:'Organic residue — slick, slightly warm, smells faintly sweet'},
  {cat:'Texture', text:'Floor grating caked with dried mud and something darker'},
  {cat:'Texture', text:'Peeling safety tape, yellow-black stripes curling at the edges'},
  {cat:'Texture', text:'Wall paint blistered from heat, rough like skin'},
  {cat:'Texture', text:'Mineral deposits crusting around a leaking valve'},
  {cat:'Texture', text:'Hairline cracks spreading across reinforced glass'},
  {cat:'Texture', text:'Rust blooming through grey paint like a rash'},
  {cat:'Texture', text:'Smooth patch on a handrail where a thousand hands have gripped'},
  {cat:'Texture', text:'Floor tiles buckled upward, something growing underneath'},

  // SOUNDS — background audio
  {cat:'Sound', text:'Distant clang — metallic, rhythmic, like someone hammering'},
  {cat:'Sound', text:'Air cycling through vents, changing pitch every few seconds'},
