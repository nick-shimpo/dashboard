  {cat:'Sound', text:'Something dragging across the floor, one room over'},
  {cat:'Sound', text:'Radio squelch — someone keying a mic but not speaking'},
  {cat:'Sound', text:'Gurgling from a drain, like it\'s trying to breathe'},
